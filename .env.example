# Postgres (state + ledger schemas in one database)
POSTGRES_USER=tabletop
POSTGRES_PASSWORD=tabletop_dev_password
POSTGRES_DB=tabletop_dm
POSTGRES_PORT=5432

# Redis (pubsub + presence + job queues)
REDIS_PASSWORD=tabletop_redis_password
REDIS_PORT=6379

# Qdrant (vector database)
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# App defaults used by upcoming services
APP_ENV=development
APP_PORT=8080
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:${REDIS_PORT}/0
QDRANT_URL=http://localhost:${QDRANT_HTTP_PORT}

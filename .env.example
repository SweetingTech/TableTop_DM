# ============================================================
# Tabletop DM - Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- Postgres ---
POSTGRES_USER=tabletop
POSTGRES_PASSWORD=tabletop_dev_password
POSTGRES_DB=tabletop_dm
POSTGRES_PORT=5432

# --- App ---
APP_ENV=development
APP_PORT=5000
SECRET_KEY=change-me-in-production

# --- Database URL ---
# For Docker Compose: uses the postgres service hostname
DATABASE_URL=postgresql://tabletop:tabletop_dev_password@postgres:5432/tabletop_dm
# For local/Replit: point to localhost or Replit's DATABASE_URL
# DATABASE_URL=postgresql://tabletop:tabletop_dev_password@localhost:5432/tabletop_dm

# --- OpenAI (for AI narration + NPC dialogue) ---
# Optional: leave blank to skip LLM features
OPENAI_API_KEY=

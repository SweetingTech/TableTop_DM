# Deterministic loopback-only values for CI and disposable test stacks.
# scripts/manage.py never copies these credentials: it creates private random
# PostgreSQL, Redis, and an automation operator secret in .env on first use.
# PostgreSQL owner credentials are used only by the migration job.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_only
POSTGRES_DB=tabletop_dm
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
DATABASE_ADMIN_URL=postgresql://postgres:postgres_dev_only@127.0.0.1:5432/tabletop_dm

# The application and worker use this non-owner, non-superuser login.
APP_DATABASE_USER=tabletop_runtime
APP_DATABASE_PASSWORD=tabletop_runtime_dev_only
DATABASE_URL=postgresql://tabletop_runtime:tabletop_runtime_dev_only@127.0.0.1:5432/tabletop_dm
DATABASE_CONNECT_TIMEOUT=5

REDIS_PASSWORD=redis_dev_only
REDIS_HOST=127.0.0.1
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://:redis_dev_only@127.0.0.1:6379/0

QDRANT_HOST=127.0.0.1
QDRANT_BIND_ADDRESS=127.0.0.1
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://127.0.0.1:6333

TTDM_ARTIFACT_ROOT=./artifacts
TTDM_LLM_MODE=mock
TTDM_RNG_SEED=1337
TTDM_OPERATOR_TOKEN=
TTDM_TELEMETRY_ENABLED=0
TTDM_DEBUG=0
TTDM_HOST=127.0.0.1
APP_BIND_ADDRESS=127.0.0.1
PORT=8000

# Optional comma-separated browser origin allowlist. Empty means same-origin.
CORS_ALLOWED_ORIGINS=

# Hosted models are optional; local deterministic and mock modes need no key.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tabletop_dm
POSTGRES_PORT=5432
REDIS_PASSWORD=redispass
REDIS_PORT=6379
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tabletop_dm
OPENAI_API_KEY=
CONTENT_MODE=SAFE

# Security: List of allowed origins for SocketIO, comma-separated.
# If empty, defaults to same-origin only.
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
